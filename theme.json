{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "palette": [
        { "slug": "bg",          "color": "#FFFFFF", "name": "Background" },
        { "slug": "bg-alt",      "color": "#F4F5FF", "name": "Background Lavender" },
        { "slug": "bg-deep",     "color": "#0D0F2C", "name": "Deep Navy" },
        { "slug": "ink",         "color": "#0D0F2C", "name": "Ink" },
        { "slug": "ink-muted",   "color": "#333B52", "name": "Ink Muted" },
        { "slug": "ink-subtle",  "color": "#6B7390", "name": "Ink Subtle" },
        { "slug": "border",      "color": "#E5E7F0", "name": "Border" },
        { "slug": "accent",      "color": "#3E57DA", "name": "Indigo Accent" },
        { "slug": "accent-soft", "color": "#EEF1FF", "name": "Indigo Soft" },
        { "slug": "accent-text", "color": "#2937B0", "name": "Indigo Text" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Manrope",
          "fontFamily": "'Manrope', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "display",
          "name": "Manrope Display",
          "fontFamily": "'Manrope', system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "xs",   "size": "0.75rem",    "name": "XS",   "fluid": false },
        { "slug": "sm",   "size": "0.875rem",   "name": "Small","fluid": false },
        { "slug": "base", "size": "1.0625rem",  "name": "Base", "fluid": false },
        { "slug": "lg",   "size": "1.1875rem",  "name": "Large" },
        { "slug": "xl",   "size": "1.375rem",   "name": "XL" },
        { "slug": "2xl",  "size": "1.75rem",    "name": "2XL" },
        { "slug": "3xl",  "size": "2.25rem",    "name": "3XL" },
        { "slug": "4xl",  "size": "3rem",       "name": "4XL", "fluid": { "min": "2.5rem", "max": "3.5rem" } },
        { "slug": "5xl",  "size": "4rem",       "name": "5XL", "fluid": { "min": "3rem", "max": "4.5rem" } },
        { "slug": "6xl",  "size": "5.5rem",     "name": "6XL", "fluid": { "min": "3.5rem", "max": "6rem" } }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "spacingScale": {
        "operator": "+",
        "increment": 4,
        "steps": 10,
        "mediumStep": 16,
        "unit": "px"
      }
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--ink-muted)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.5"
    },
    "elements": {
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.05", "letterSpacing": "-0.04em" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.1",  "letterSpacing": "-0.035em" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.2",  "letterSpacing": "-0.025em" } },
      "h4": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.3" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent)" } }
    }
  }
}
